ENVIRONMENT=development
API_PORT=5685

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=siepa

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=siepa
RABBITMQ_PASSWORD=siepa

SECRET_KEY=dev-secret-change-me
GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/unirio/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:4200/dashboard
FRONTEND_AUTH_ERROR_URL=http://localhost:4200/login?error=google_auth_failed
