ENVIRONMENT=development
API_PORT=5685

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=prisma

REDIS_HOST=redis
REDIS_PORT=6379
# Redis nao exige senha nos ambientes gerenciados pelo projeto; deixe em branco.
REDIS_PASSWORD=

SECRET_KEY=dev-secret-change-me
GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5685/api/v1/unirio/auth/google/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:4200/
FRONTEND_AUTH_ERROR_URL=http://localhost:4200/signin?error=google_auth_failed
ALLOWED_GOOGLE_DOMAINS=edu.unirio.br,unirio.br
GOOGLE_OAUTH_STATE_TTL_SECONDS=300
GOOGLE_OAUTH_CLOCK_SKEW_SECONDS=10
HTTP_CLIENT_TIMEOUT_SECONDS=10
HTTP_CLIENT_MAX_CONNECTIONS=100
HTTP_CLIENT_MAX_KEEPALIVE_CONNECTIONS=20
SIE_API_BASE_URL=https://api.unirio.br/api/v2
SIE_EMAIL=
SIE_PASSWORD=
SIE_SYNC_PAGE_SIZE=500
SIE_SYNC_INTERVAL_DAYS=15
SIE_SYNC_RETRY_SECONDS=300
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALLOWED_EMAIL_DOMAIN=edu.unirio.br
# Origens permitidas para CORS (CSV). Em producao mantenha vazio e informe apenas
# origens explicitas. Nunca use "*" com credenciais habilitadas.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Diretorio local pertencente ao backend para capas enviadas.
PROJECT_COVER_UPLOAD_DIR=project-covers
PROJECT_COVER_PUBLIC_PATH=assets/project-covers
